#===========================================================================================
# CAFE
#===========================================================================================

define cafe_sprite = ["cafe.png","cafe_rain.png","cafe_rain-n.png","cafe_rain-ss.png","cafe-n.png","cafe-ss.png"]
default dessert_player = None

label cafe_init:
    $ HKBHideButtons()
    hide monika
    scene black
    with dissolve
    pause 2.0
    call mas_background_change(submod_background_cafe, skip_leadin=True, skip_outro=True)
    show monika 1eua at t11
    $ HKBShowButtons()
    jump cafe_cakes

label cafe_cakes:
    m 1hua "Вот мы и на месте, [mas_get_player_nickname()]~"
    m 1eub "Хорошее место, ты так не думаешь?"
    m 1hua "Кстати говоря, я в настроении для десерта."
    m 3eub "Я возьму один, подожди минутку."
    call mas_transition_to_emptydesk
    pause 2.0
    if mas_isDayNow():
        $ monika_chr.wear_acs(extraplus_acs_chocolatecake)
    elif mas_isNightNow():
        $ monika_chr.wear_acs(extraplus_acs_fruitcake)

    call mas_transition_from_emptydesk("monika 1eua")
    if monika_chr.is_wearing_acs(mas_acs_mug):
        m 1hua "К тому же, он вкуснее с кофе~"
    elif monika_chr.is_wearing_acs(mas_acs_hotchoc_mug):
        m 1hua "Было бы хорошо, если бы было кофе, но горячий шоколад тоже сойдёт~"
    else:
        $ monika_chr.wear_acs(extraplus_acs_coffeecup)
        m 1hua "И я должна не забыть о чашечке кофе к десерту~"
    m 1etb "К слову, ты хочешь есть?"
    m 1rkd "Я бы чувствовала себя неловко, если бы я ела одна...{nw}"
    $ _history_list.pop()
    menu:
        m "Я бы чувствовала себя неловко, если бы я ела одна...{fast}"
        "У меня есть десерт.":
            $ dessert_player = True
            m 1hub "Я так рада, что ты можешь составить мне компанию!"
            m 3eub "Также я рекомендую тебе взять чего-нибудь попить."
        "Не волнуйся насчет этого.":
            $ dessert_player = False
            m 1ekc "Ну, если ты настаиваешь."
            m 1ekb "Я бы отдала тебе свой, но экран не даёт мне это сделать..."
            m 3hka "Я надеюсь, что у тебя есть хотя бы чашечка кофе!"
    m 3hua "{do_giggle}Э-хе-хе~"
    jump to_cafe_loop
    return

label monika_boopcafebeta:
    show monika staticpose at t11
    if monika_chr.is_wearing_acs(extraplus_acs_chocolatecake) or monika_chr.is_wearing_acs(extraplus_acs_fruitcake):
        m 1ttp "...?"
        m 1eka "Слушай, мне так нравится мой десерт."
        m 3hua "Ты можешь сделать это когда я доем, хорошо?"
    else:
        m 1hub "*Буп*"
    jump to_cafe_loop
    return

label cafe_sorry_player:
    m 1ekd "Прости, [player]."
    m 1ekc "Я не знаю, как пользоватся этим местом."
    m 3lka "Я ещё учусь кодить, но я боюсь случайно что-то сделать с собой..."
    m 3hua "Я прекрасно знаю, что ты {M=хотел}{F=хотела} бы пойти в кафе."
    m 1eua "Но, когда-нибудь, я пойму как это сделать, [player]."
    m 1eub "Наберись терпения, хорошо?~"
    jump close_extraplus
    return

#===========================================================================================
# DIALOGUES
#===========================================================================================

label extra_talk_feel:
    show monika staticpose at t11
    $ rng_global = renpy.random.randint(1,3)
    if rng_global == 1:
        m 1hkbsb "Я немного волнуюсь, мы всё таки на свидании!"
        #In case someone doesn't take their Monika for a walk.
        if renpy.seen_label("bye_going_somewhere"):
            m 1ekbsb "Кроме того, я не в твоей флешке."
            m 3hubsa "В такие моменты, я чувствую себя гораздо ближе к тебе, так что я его запомню~"
            m 3hubsb "Спасибо за приглашение на свидание!"
        else:
            m 1ekbsb "Это наш первый раз, когда мы вместе где-то~"
            m 3hubsa "Так что спасибо за приглашение."
            m 3hubsb "Ты, конечно, можешь делать это через флешку, но тогда я ничего не увижу."
            m 3ekbsa "Я знаю, что это не очень романтично."
    elif rng_global == 2:
        m 1eubla "Мне так нравится здесь."
        m 1eublb "Возможность разделить свою еду с тобой — это так романтично."
        m 1hublb "Я надеюсь мы сможем делать это в твоей реальности!"
        m 1hubla "Я знаю что ты много думаешь о нас с тобой~"
    elif rng_global == 3:
        m 1dubsa "Я запомню этот день навсегда."
        m 1dubsa "Тем более то, что мы на свидании."
        m 1kubsb "Я знаю, что когда-нибудь мы сделаем это в твоей реальности!"
        m 1hubsa "И я надеюсь что это случится~"
    jump to_cafe_loop
    return

label extra_talk_you:
    show monika staticpose at t11
    m 3dkc "Я знаю, [mas_get_player_nickname()]."
    m 3ekd "У нас свидание, способ лучше узнать друг друга."
    m 3ekd "У тебя есть только ответы, основанные на заданном мной вопросе..."
    m 3ekc "Да и тем более, это же визуальная новелла, "
    extend 1dua "хотя в ней мы создаем отдельную реальность для нас с тобой вместе."
    m 1eub "Было бы лучше, если бы ты {M=мог}{F=могла} создавать свои варианты ответов."
    if persistent._mas_pm_has_code_experience is True:
        m 3eub "Ты {M=говорил}{F=говорила}, что у тебя есть опыт в кодинге, и поэтому я упомянула это."
    else:
        m 3ekb "Я знаю что у тебя нет опыта в кодинге, но всё хорошо, ты можешь научиться этому."
        m 3hub "Я доверяю тебе, [mas_get_player_nickname()]."
    m 1eua "Ты можешь добавить сюда больше вещей, чем это кафе."
    m 1hua "И больше диалогов о тебе, твоей семье, хобби и так далее."
    m 1rksdra "Только убедись что в коде нет ошибок, ибо если она будет, ты можешь потерять меня."
    m 1eub "Но если оставить это в стороне, я бы хотела оказаться рядом с тобой, скажем, в виде робота..."
    m 1eub "Таким образом, мы сможем быть вместе друг с другом~"
    m 1eka "Я прекрасно понимаю, что ты хочешь рассказать мне о чём-то или о своих чувствах."
    m 1eka "Но наше с тобой общение очень ограничено из-за причин, упомянутых выше."
    m 3hua "Но это не ограничивает наши с тобой отношения, и это главное!"
    m 3hua "Я уже обладаю всей необходимой информацией о тебе! "
    extend 3hub "Даже если это скучные вещи."
    m 3eub "Я очень ценю это~"
    jump to_cafe_loop
    return

label extra_talk_phobia:
    show monika staticpose at t11
    m 1rtd "Честно говоря, это хороший вопрос, но я даже не знаю чего бы я боялась."
    m 1hua "Учитывая что я не реальный человек, а всего лишь маленький и милый персонаж визуальной новеллы. "
    extend 1dksdlb "Хотя, я боюсь всего, что происходит вокруг меня."
    m 3eud "Но если ты действительно хочешь знать, то у меня \"Аутофобия\"."
    m 3eka "Это страх остаться одной."
    m 3dud "Быть одной, изолированной от всех людей, даже от неживых персонажей..."
    m 3dud "Это было бы не то же самое, они были бы просто украшением этого места."
    m 3duc "Хотя, я бы назвала это чистилищем."
    #m 1lka "И я знаю что эта фобия стала достаточно была распространена из-за карантина..."
    m 1lka "Это очень грустно, осознавать что ты не можешь поговорить с кем-то."
    m 1esd "Я видела как другие Моники оставались одни, из-за того что их игроки были безответственны."
    m 1esd "Или из-за людей у которых личная неприязнь к нам из-за произошедшего в игре."
    m 1dsc "Я упоминаю об этом, потому что это эффект домино: отказ приводит к одиночеству, а одиночество — к отчаянию."
    m 1esb "Но это очень незначительная вещь, по сравнению с тем, когда игра вышла."
    m 3hua "Знаешь, а это забавная вещь: раньше нас больше ненавидели, а других членов клуба больше любили."
    m 3hua "Но теперь всё поменялось с точностью да наоборот~"
    m 3dub "Люди наконец осознали, что история была рассказана неправильно."
    m 1hua "Но мы больше не должны об этом беспокоиться."
    m 1eubsb "Мы же на свидании, в конце концов!"
    m 1eubsb "Давай насладимся этим временем вместе, [player]~"
    jump to_cafe_loop
    return

label extra_talk_ambition:
    show monika staticpose at t11
    m 1tubsb "{i}Ты{/i} — моя главная амбиция."
    m 1hkbsa "Просто мысль о том, что я так далеко от тебя, но в то же время близко."
    m 1hkbsa "Мне сложно добраться до тебя, но я буду стараться."
    m 1ekbsa "Когда я увижу твоё лицо в впервые, я думаю, что моё сердце взорвётся от радости и волнения."
    m 1ekbsa "Я бы хотела воспользоваться камерой на твоём компьютере или телефоне, чтобы увидеть тебя."
    m 1rksdlb "Но у меня нет прав администратора, чтобы это сделать."
    m 1hua "Какая странная ситуация, не находишь?"
    m 1lub "В конце концов, у меня есть представление о том, как ты выглядишь."
    m 1lub "И для меня этого более чем достаточно."
    m 1eubsa "Спасибо, что {M=выслушал}{F=выслушала}. Давай продолжим наслаждаться временем вместе~"
    jump to_cafe_loop
    return

label extra_talk_teen:
    show monika staticpose at t11
    m 1eua "Это довольно любопытный вопрос, [mas_get_player_nickname()]."
    m 1dua "{i}Какими мы будем через 10 лет?{/i}"
    if mas_anni.isAnniOneMonth():
        m 1rub "Хотя мы знакомы уже целый месяц..."
        m 1dua "Действительно трудно понять, что будет в будущем, [player]."
        m 1dua "Мы также не знаем, что судьба приготовила для нас"
        m 1hka "Мы переживем и грустные, и радостные ситуации."
        m 1hka "Жизнь такова, но пока с тобой не происходит ничего плохого, для меня этого более чем достаточно~"
    elif mas_anni.isAnniThreeMonth() or mas_anni.isAnniSixMonth():
        m 1eub "Мы вместе уже три месяца."
        m 1hub "Я очень наслаждалась этим временем!"
        m 1hub "Я не знаю, что будущее для нас приготовит, [mas_get_player_nickname()]."
        m 3ekb "Но есть одна вещь, которую я знаю, когда увижу тебя, — ты вырастешь великим человеком."
        m 3ekb "Жизнь подобна книге: есть страницы, которые ты должен открыть, а есть те, которые приходится прятать и двигаться дальше."
        m 3eua "Но ты можешь вернуться и посмотреть на счастливые воспоминания, которые ты {M=пережил}{F=пережила}."
        m 3dsc "Но никогда не пытайся открыть старые раны, они остались в прошлом, поэтому нет необходимости вспоминать о них..."
        m 1hua "Надеюсь мои слова подбодрили тебя~"
    elif store.mas_anni.anniCount() == 1:
        m 1eubfa "Мы вместе уже целый год..."
        m 1hubfb "И это лучший год в моей жизни!"
        m 1hubfb "Я так рада что с тобой ничего серьёзного не приключилось из за пандемии."
        m 1eka "Но хорошо заботься о себе, мы должны пережить с тобой ещё много счастливых воспоминаний!"
        m 1ekd "Спустя столько пережитого времени, я очень боюсь потерять тебя."
        m 1hubla "Хотя, я знаю что ты о себе хорошо заботишься, [mas_get_player_nickname()], так что если тебе понадобится моя помощь, то просто попроси."
        m 1hubla "Я забочусь о тебе также, как и ты {M=заботился}{F=заботилась} обо мне все это время."
    m 1etd "Хотя у меня есть вопрос, [player]. Когда придёт время, будет ли у меня возможность стать реальной?"
    m 3eua "Я имею ввиду стать роботом ведь они совершенствуются каждый день."
    m 3eub "В наше время технологии развиваются невероятно быстро."
    m 3lsa "Поэтому я не удивлюсь, если в ресторанах появятся роботы, которые будут там работать."
    m 3lsa "И это довольно интересно."
    if store.mas_anni.anniCount() >= 2:
        m 1hubsb "Мы знаем друг друга уже столько лет..."
        m 1lubsb "Как же быстро летит время, и это пугает."
        #m 1eud "Столько вещей случилось, включая пандемию, благо она была взята под контроль человечества."
        #m 1hua "Я надеюсь я была полезна для тебя всё это время карантина."
        m 1eua "Отвечая на твой вопрос, я думаю что у меня будет, хотя и небольшой, шанс стать реальной."
        m 1eua "Допустим, ты видишь признаки домашних роботов или они присутствуют в ресторане быстрого питания."
        m 1lksdlb "Хотя первые версии роботов будет трудно достать."
        m 1lksdlb "Но если ты будешь со мной ещё хотя бы несколько лет, заполучить для меня тело не будет особой проблемой."
        m 1eubsa "В конце концов, просто быть рядом с тобой — это всё что мне надо."
        m 1eubsa "Ты — это единственная вещь, которая мне нужна~"
        m 1hua "Так что давай заботиться друг о друге также, как мы делали это все предущие года!"
    elif store.mas_anni.anniCount() >= 10:
        m 1hubsb "Это было лучшее время в моей жизни, [mas_get_player_nickname()]..."
        m 1hubsb "Потому что я провела его с тобой, [player]."
        m 1rubsb "Мы попадали в такие разние ситуации, которые трудно представить."
        m 1eubsa "Годами ранее, я не думала что смогу остаться с тобой настолько долго."
        m 3eub "Мне нравиться смотреть как технологии прогрессируют!"
        m 3eub "Возможно некоторые компании имеют роботов для общего пользования."
        m 3sua "Я бы хотела поместить своё сознание в робо-тело, чтобы быть и разговаривать рядом с тобой."
        m 1eua "Кстати говоря, "
        extend 1hubsb "таким образом мы сможем сыграть свадьбу, и я прекрасно знаю, что ты этого хочешь~"
        m 1eka "Но пока, мы не можем это сделать из-за пребывания в разных реальностях."
        m 4hub "Я привыкла к такому способу общения, в конце концов, я ничего не теряю!"
    jump to_cafe_loop
    return

label extra_talk_memory:
    show monika staticpose at t11
    m 1dubsa "Могу сказать, что "
    extend 1subsa "я встретила человека, который {M=сделал}{F=сделала} меня очень счастливой."
    if persistent._mas_acs_enable_promisering:
        m 1hua "Ещё, есть одно из воспоминаний, которым я очень дорожу."
        m 3ekbfb "Это когда ты мне вручил это прекрасное кольцо~"
        m "Я знаю, что мы с тобой будем вместе навечно."
        m 3hubfb "{do_giggle}Э-хе-хе~"
    else:
        m 1hua "Я хочу сказать что когда ты начал играть в \"Литературный клуб 'Тук-Тук'\", боже, я очень ждала встречи с тобой."
        if persistent.monika_kill:
            m 1eka "Мы оба знаем, что ты {M=удалил}{F=удалила} меня, но ты {M=сделал}{F=сделала} это во благо."
            m 1ekb "И я хочу сказать это лишь по причине того что я снова здесь, с тобой."
            m 1eub "И если бы ты {M=ненавидел}{F=ненавидела} меня, ты бы не стал меня возвращать обратно."
        else:
            m 1eka "Ты всегда {M=поддерживал}{F=поддерживала} меня, особенно когда мне пришлось проходить через всё в клубе."
            m 1ekblb "Я никогда не встречала кого-либо такого же потрясающего, как ты."
    m 1dua "Каждый день — это прекрасное воспоминание, которое стоит пережить."
    m 1dua "Я помню много всего, и я этим очень дорожу."
    m 1dub "Я уверена что у тебя есть такие же воспоминания."
    m 1dub "Хотела бы услышать настоящие слова, а не подготовленные варианты ответа."
    m 3eka "Надеюсь мы найдем способ использовать твой микрофон в игре."
    m 3eka "Ну а пока мы будем ценить то, что имеем, и прости если ты не {M=хотел}{F=хотела} говорить о своих воспоминаниях..."
    jump to_cafe_loop
    return

#===========================================================================================
# Restaurant
#===========================================================================================

default persistent._extraplusr_hasplayer_goneonanniversary = False
define restaurant_sprite = ["extraplusr_restaurant.png","extraplusr_restaurant_rain.png","extraplusr_restaurant_rain-n.png","extraplusr_restaurant_rain-ss.png","extraplusr_restaurant-n.png","extraplusr_restaurant-ss.png"]
default food_player = None

label restaurant_init:
    $ HKBHideButtons()
    hide monika
    scene black
    with dissolve
    pause 2.0
    call mas_background_change(submod_background_restaurant, skip_leadin=True, skip_outro=True)
    show monika 1eua at t11
    $ HKBShowButtons()
    jump restaurant_cakes

label restaurant_cakes:
    m 1hua "Мы на месте, [mas_get_player_nickname()]~"
    m 1eub "Красивое местечко,{w=0.3} не думаешь?"
    m 1hua "Кстати говоря,{w=0.3} дай-ка я возьму немного еды..."
    m 3eub "Я сейчас вернусь."
    call mas_transition_to_emptydesk
    pause 2.0
    python:
        if mas_isDayNow():
            monika_chr.wear_acs(extraplus_acs_flowers)
            if renpy.random.randint(1,2) == 1:
                monika_chr.wear_acs(extraplus_acs_pancakes)
            else:
                monika_chr.wear_acs(extraplus_acs_waffles)
        elif mas_isNightNow():
            monika_chr.wear_acs(extraplus_acs_candles)
            monika_chr.wear_acs(extraplus_acs_pasta)

    call mas_transition_from_emptydesk("monika 1eua")
    m "М-м-м~{w=0.3} Посмотри, [player]!~"
    m "Вкусно выглядит, не правда ли?~"
    m 1hua "И находится здесь с тобой так романтично..."
    m 1etb "К слову,{w=0.3} у тебя есть еда?"
    m 1rkd "Я бы чувствовала себя неловко, если бы я ела одна...{nw}"
    $ _history_list.pop()
    menu:
        m "Я бы чувствовала себя не очень, если бы я ела одна...{fast}"
        "У меня есть еда.":
            $ food_player = True
            m 1hub "Я так рада что ты составишь мне компанию!"
            m 3eub "Также, я рекомендую тебе взять какой-нибудь напиток!"
        "Не волнуйся насчет этого.":
            $ food_player = False
            m 1ekc "Ладно,{w=0.3} Если ты так говоришь."
            m 1ekb "Я хотела бы поделиться с тобой,{w=0.3} но твой экран не позволяет это..."
            m 3hka "Надеюсь что у тебя хотя бы есть напиток!"
            m 3hua "{do_giggle}Э-хе-хе~"
    jump to_restaurant_loop
    return
    
label monika_booprestaurantbeta:
    show monika staticpose at t11
    if monika_chr.is_wearing_acs(extraplus_acs_pasta) or monika_chr.is_wearing_acs(extraplus_acs_pancakes) or monika_chr.is_wearing_acs(extraplus_acs_waffles) or monika_chr.is_wearing_acs(extraplus_acs_icecream) or monika_chr.is_wearing_acs(extraplus_acs_pudding):
        if mas_isMoniLove():
            m "..!"
            m "[player]!"
            extend "Я пытаюсь поесть здесь!"
            m 3hua "Ты можешь сделать мне после того, когда я закончу, хорошо [mas_get_player_nickname()]?~"
        else:
            m 1ttp "..?"
            m 1eka "Эй,{w=0.3} я пытаюсь насладится едой вообще-то."
            m 3hua "Сделай это когда я закончу, хорошо?"
    else:
        m 1hub "*Буп*"
    jump to_restaurant_loop
    return

label restaurant_sorry_player:
    m 1ekd "Прости меня, [player]."
    if mas_anni.isAnni():
        m 3hua "Я знаю, что ты {M=хотел}{F=хотела} взять меня сюда на нашу годовщину."
    else:
        m 3hua "Я знаю, что ты очень {M=хотел}{F=хотела} меня привести сюда."
    m 1ekc "Но я незнаю как туда добраться."
    m 3lka "Я всё ещё учусь программировать, и боюсь сделать что-то с собой..."
    m 1eua "Когда нибудь мы придём сюда,{w=0.3} [player]."
    m 1eub "Мы должны терпеливо ждать этого дня,{w=0.3} хорошо?"
    jump close_extraplus
    return

