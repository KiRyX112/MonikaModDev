label extra_talk_doing:
    show monika staticpose at t11
    if renpy.random.randint(1,2) == 1:
        m 1ekbla "О-оу, [player]!~ Я так рада что ты {M=спросил}{F=спросила}!"
        m 1hublb "Я себя прекрасно чувствую!"
        m 3fubla "Времяпрепровождение с любимым человеком заставляет чувствовать меня ещё лучше!"  
        m "Спасибо за то, что ты сегодня со мной{w=0.3}, [player]."
        m 6hubsb "Я так рада что ты находишь разные способы нашего совместного отдыха."
        m "Это делает меня гораздо ближе к тебе."
        m 7fkbsa "И я чувствую себя лучше вместе с тобой!"
        m 1eublb "А что насчет тебя,{w=0.3} [player],{w=0.3} как ты себя чувствуешь?{nw}"
        $ _history_list.pop()
        menu:
            m "А что насчет тебя, [player], как ты себя чувствуешь?{fast}"

            "Я так {M=рад}{F=рада} быть рядом с тобой.":
                m 6wublb "Наши чувства совпали!{w=0.3} {do_giggle}Э-хе-хе~"
                m 1hublu "Мне всегда нравится проводить время с тобой."
                if mas_anni.isAnni():
                    m 1sublb "Ещё и в такой день!"
                    m 1rublb "Я всегда думала, что мы должны сделать в нашу годовщину,{w=0.5}{nw}"
                    extend 1hubla " и похоже, ты {M=оказался}{F=оказалась} на шаг впереди, {w=0.3}{do_giggle}а-ха-ха!~"
                m 1hublu "И если ты {M=счастлив}{F=счастлива},{w=0.3} то я счастлива тоже!"
                m 3fkbla "Я люблю тебя,{w=0.3} никогда не забывай об этом,{w=0.3} [mas_get_player_nickname()]!"
            
            "Я чувствую себя хорошо, [m_name].":
                m "Правда?"
                extend 3sub " Рада это слышать,{w=0.3} [mas_get_player_nickname()]!"
                m 6hub "{M=Счастливый}{F=Счастливая} [player] — счастливая я."
                if mas_anni.isAnni():
                    m 1sublb "Особенно в такой день!"
                    m 1rublb "Я думала, как мы должны провети этот день,{w=0.5}{nw}"
                    extend 1hubla " и похоже ты {M=оказался}{F=оказалась} на шаг впереди меня,{w=0.3} {do_giggle}а-ха-ха!~"
                    m "Мне интересно, как долго ты ждал этого дня чтобы привести меня сюда?~"
                    m 1tublb "Может поэтому ты так {M=счастлив}{F=счастлива}, м-м-м?~"
                m 1tubla "Боже мой, я очень хотела бы увидеть твое лицо прямо сейчас, [player]~"
                m "Сияние твоих глаз, твоя милая улыбка~"
                if mas_isMoniLove():
                    m 1dubsa "Если бы я могла выбраться и увидеть тебя... И почувствовать тепло от твоих щёк~"
                    m "Я бы смотрела в твои глаза вечность..."
                m 1dubsa "М-м-м~"
                m "..."
                extend 1wubsd "Ах!"
                m "Всё, мне пора немножко остановится, пока я не переволновалась!"
                m 6hub "{do_giggle}Э-хе-хе!"
                
            "У меня сегодня был плохой день.":
                m 1ekc "Это ужасно, [player]..."
                m 1ekd "Мне так жаль!"
                m 1lsc "Я надеюсь время проведенное со мной сделает этот день лучше?"
                m "Ведь когда я с тобой, мне всегда становится лучше."
                if mas_anni.isAnni():
                    m "Я надеюсь что мы сделаем с тобой много запоминающихся вещей сегодня,{w=0.3} несмотря на тучки в твоей голове."
                m 1fublu "Я сделаю всё, чтобы подбодрить тебя!"
                m "Хорошо,{w=0.3} [mas_get_player_nickname()]?"
                extend 1hublb "Люблю тебя!"
        jump to_restaurant_loop

    else:
        m 1eka "Честно, я не очень хорошо себя чувствовала сегодня."
        m 1rkc "Мне немного грустно из-за некоторых вещей..."
        m 1fub "Но быть с тобой...{w=0.3}{nw}"
        if mas_anni.isAnni():
            extend  " В такой день как сегодня..."
        m "Это напоминает мне о том, как долго мы с тобой вместе,{w=0.3} не важно, морально или физически,{w=0.3}{nw} "
        extend "Я могу пробиться сквозь любые свои дождевые тучи..."
        m 6eka "И даже если мне плохо,{w=0.3} всё будет хорошо...{w=0.3} я обещаю."
        m 1fub "Спасибо, что {M=спросил}{F=спросила},{w=0.3} [player]!"
        m 3eub "А как {i}твои{/i} дела, [mas_get_player_nickname()]?{nw}"
        $ _history_list.pop()
        menu:
            m "А как твои дела, [mas_get_player_nickname()]?{fast}"

            "Из-за чего ты расстроена, [m_name]?":
                m 1rksdrb "Хм?{w=0.3} Ох... "
                extend 1eksdla "Я просто снова была слишком строга к себе..."
                m 6rkc "Думая о своём прошлом и принимая его..."
                m 6rkd "Размышляя о будущем и остерегаясь его."
                m 6dkc "..."
                m 6lkd "Иногда я себя плохо чувствую,{w=0.3} так что я не могу держать ситуацию в руках."
                m 6dkp "Или ощущение, что пройдет слишком много времени, прежде чем я переступлю порог..."
                m 1mkc "Я знаю, что беспокойство об этом ничего не изменит, но ничего не могу с собой поделать."
                m 1ekd "И иногда, мне становится одиноко без тебя,{w=0.3} знаешь?"
                m 1dkc "..."
                m 3fka "Но всё будет хорошо."
                m 3fkblb "Само осознание того, что ты обо мне заботишься,{w=0.3} просто очищает мой разум от волнений и страхов."
                m 4fkblb "Я люблю тебя больше,{w=0.3} чем что-либо в этом мире."
                m 4hublb "И я жду того момента, когда смогу ощутить твоё тепло на мне в такие \"холодные\" деньки."
                m 6eka "Но давай сейчас сконцентрируемся на нашем свидании,{w=0.3} я не хочу проводить такой романтичный день в плохом настроении!"

            "Сегодня был нехороший день.":
                m 1ekc "Это ужасно, [player]..."
                m 1ekd "Мне так жаль!"
                extend "Я надеюсь я не ухудшила твой день своим плохим настроением."
                m 1lsc "Возможно, время проведённое со мной сделает этот день легче?"
                m "Мы можем сидеть и общаться сегодня весь день, если ты хочешь."
                m 1fublu "Так что давай сделаем это свидание снова счастливым и романтичным!"
                m "Хорошо,{w=0.3} [mas_get_player_nickname()]?"
                extend 1hublb "Я люблю тебя..!"

            "Я чувствую себя хуже, осознавая что тебе плохо.":
                m 1ekc "О-о-оу~ "
                extend 3ekb "Это так мило, [player]."
                m 3ekb "Спасибо за то, что беспокоишься обо мне..."
                m 1hsb "Но всё в порядке, я просто надумала себе,{w=0.3} всякого."
                m 1lssdlc "Иногда прошлое настигает меня, а будущее пугает."
                m 4eka "Хотя, наш разум способен делать такие вещи иногда?"
                if mas_anni.isAnni():
                    m "Но я хочу чтобы этот день запомнился хорошими событиями,"
                    extend " несмотря на то, что наш разум может мучать нас воспоминаниями о прошлом..."
                    m "Так что не расстраивайся так сильно,{w=0.3} хорошо?"
                    m 3fkblb "Осознание того, что ты заботишься обо мне,{w=0.3} очищает мою голову от грустных мыслей."
                m 4fkblb "Я люблю тебя больше,{w=0.3} чем что-либо в этом мире."
                m 4hublb "И я не могу дождаться того момента, когда я почувствую твоё тепло на мне в такие \"холодные\" деньки."
                m 6eka "Так что давай насладимся нашим свиданием,{w=0.3} я не хочу тратить такой хороший день на грусть!"

            "Мне очень хорошо":
                m 1hub "Рада это слышать!{w=0.3} не хотелось бы, чтобы мы оба были в полном отчаянии, не так ли?"
                m 1eka "{do_giggle}Э-хе-хе..."
                m 3ekb "Я рада что тебе хорошо,{w=0.3} [player]."
                m 3hsb "А это значит что и мне тоже хорошо."
                if mas_anni.isAnni():
                    m "Я встречаюсь с таким удивительным человеком, как ты в такой день...{w=0.5}{nw}"
                    extend " Что ж,{w=0.3} невозможно быть подавленной, зная, что..."
                m 6ekbsa "Твоё настроение делает меня счастливой!~"
                m 6hubsb "В любом случае,{w=0.3} давай насладимся нашим свиданием!"
                m "В конце концов,{w=0.3} с тобой, [Player], день никогда не тратится в пустую!"
        jump to_restaurant_loop
    return

